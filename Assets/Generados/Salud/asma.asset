  m_Script: {fileID: 11500000, guid: d11f3cae32d1ac0468eca355507c096d, type: 3}
  m_Name: asma
  m_EditorClassIdentifier: Assembly-CSharp::Enfermedad
  id: asma
  nombre: Crisis de asma por polvo
  sintomas: "Tos, silbidos al respirar, falta de aire y opresi\xF3n en el pecho."
  tratamiento: "Aleja a la persona del polvo.\nSi\xE9ntala erguida y ay\xFAdala a
    calmarse.\nAy\xFAdala a usar su inhalador de rescate.\nPide ayuda urgente si
    no mejora o tiene los labios azulados."
  preguntas:
  - texto: "\xBFEn qu\xE9 postura debe estar alguien con una crisis de asma?"
    opciones:
    - Sentado y erguido
    - Acostado boca arriba
    - "Caminando r\xE1pido"
    correcta: 0
    explicacion: Sentado y erguido respira mejor.
  - texto: "\xBFQu\xE9 medicamento ayuda r\xE1pido en una crisis de asma?"
    opciones:
    - "Un antibi\xF3tico"
    - El inhalador de rescate
    - Una pastilla para dormir
    correcta: 1
    explicacion: "El inhalador de rescate abre las v\xEDas respiratorias."
  - texto: "\xBFQu\xE9 se\xF1al indica que se necesita ayuda urgente?"
    opciones:
    - Un poco de tos
    - Sentir sed
    - Labios azulados
    correcta: 2
    explicacion: "Los labios azulados indican que falta ox\xEDgeno."
