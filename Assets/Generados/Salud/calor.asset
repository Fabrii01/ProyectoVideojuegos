  m_Script: {fileID: 11500000, guid: d11f3cae32d1ac0468eca355507c096d, type: 3}
  m_Name: calor
  m_EditorClassIdentifier: Assembly-CSharp::Enfermedad
  id: calor
  nombre: Golpe de calor
  sintomas: "Temperatura corporal muy alta, piel caliente, confusi\xF3n y hasta desmayo."
  tratamiento: "Llama a emergencias: es grave.\nLleva a la persona a la sombra.\nEnfr\xEDala
    con agua y pa\xF1os en cuello, axilas e ingles.\nDale sorbos de agua solo si
    est\xE1 consciente."
  preguntas:
  - texto: "\xBFD\xF3nde conviene poner pa\xF1os fr\xEDos en un golpe de calor?"
    opciones:
    - Solo en las manos
    - Cuello, axilas e ingles
    - En la espalda baja
    correcta: 1
    explicacion: "En esas zonas pasan vasos grandes y el cuerpo se enfr\xEDa m\xE1s
      r\xE1pido."
  - texto: "\xBFCu\xE1ndo se le puede dar agua a la persona?"
    opciones:
    - "Solo si est\xE1 consciente"
    - "Siempre, aunque est\xE9 desmayada"
    - Nunca
    correcta: 0
    explicacion: "Si no est\xE1 consciente podr\xEDa ahogarse."
  - texto: "\xBFQu\xE9 se debe hacer adem\xE1s de enfriarla?"
    opciones:
    - Abrigarla
    - Hacerla correr
    - Llamar a emergencias
    correcta: 2
    explicacion: "Es una emergencia m\xE9dica y necesita atenci\xF3n profesional."
