  m_Script: {fileID: 11500000, guid: d11f3cae32d1ac0468eca355507c096d, type: 3}
  m_Name: descompresion
  m_EditorClassIdentifier: Assembly-CSharp::Enfermedad
  id: descompresion
  nombre: "Enfermedad por descompresi\xF3n"
  sintomas: "Burbujas de gas en el cuerpo por un cambio brusco de presi\xF3n. Dolor
    en articulaciones, mareo y hormigueo."
  tratamiento: "Mant\xE9n a la persona en reposo.\nDale ox\xEDgeno al 100 % si hay
    disponible.\nTrasl\xE1dala a una c\xE1mara hiperb\xE1rica.\nAfecta a buzos y
    astronautas."
  preguntas:
  - texto: "\xBFQu\xE9 causa la enfermedad por descompresi\xF3n?"
    opciones:
    - Comer demasiado
    - "Un cambio brusco de presi\xF3n"
    - "El fr\xEDo"
    correcta: 1
    explicacion: "Al bajar r\xE1pido la presi\xF3n se forman burbujas de gas en el
      cuerpo."
  - texto: "\xBFD\xF3nde se trata esta enfermedad?"
    opciones:
    - "En una c\xE1mara hiperb\xE1rica"
    - En una sauna
    - En una piscina
    correcta: 0
    explicacion: "La c\xE1mara hiperb\xE1rica sube la presi\xF3n para reducir las
      burbujas."
  - texto: "\xBFQu\xE9 s\xEDntoma es com\xFAn?"
    opciones:
    - Hambre
    - Hipo
    - Dolor en las articulaciones
    correcta: 2
    explicacion: "Es t\xEDpico el dolor en las articulaciones, adem\xE1s de mareo
      y hormigueo."
