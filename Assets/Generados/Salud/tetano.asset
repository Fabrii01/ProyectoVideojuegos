  m_Script: {fileID: 11500000, guid: d11f3cae32d1ac0468eca355507c096d, type: 3}
  m_Name: tetano
  m_EditorClassIdentifier: Assembly-CSharp::Enfermedad
  id: tetano
  nombre: "Riesgo de t\xE9tanos"
  sintomas: "Herida sucia con tierra u \xF3xido. M\xE1s tarde puede dar rigidez en
    la mand\xEDbula y espasmos."
  tratamiento: "Lava la herida con agua limpia y jab\xF3n.\nC\xFAbrela con un ap\xF3sito
    limpio.\nRevisa si la vacuna antitet\xE1nica est\xE1 al d\xEDa.\nAcude a un centro
    de salud para valorar la herida."
  preguntas:
  - texto: "\xBFQu\xE9 es lo primero que se hace con una herida sucia?"
    opciones:
    - "Lavarla con agua limpia y jab\xF3n"
    - Taparla sin limpiarla
    - Echarle tierra para secarla
    correcta: 0
    explicacion: "Lavarla con agua limpia y jab\xF3n retira la suciedad."
  - texto: "\xBFQu\xE9 previene el t\xE9tanos?"
    opciones:
    - Tomar agua
    - "La vacuna antitet\xE1nica"
    - Descansar mucho
    correcta: 1
    explicacion: "La vacuna antitet\xE1nica protege, y necesita refuerzos."
  - texto: "\xBFCu\xE1l es un s\xEDntoma t\xEDpico del t\xE9tanos?"
    opciones:
    - "Rigidez en la mand\xEDbula"
    - Estornudos
    - "Picaz\xF3n en los ojos"
    correcta: 0
    explicacion: "El t\xE9tanos causa rigidez, muchas veces primero en la mand\xEDbula."
