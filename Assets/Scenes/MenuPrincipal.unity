  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>OBJETIVOS DE LA OPERACI\xD3N:</b>\n\u2022 Recolecta las <b>Jeringas
    M\xE9dicas</b> (luz azul) y <b>Equipajes de Salud</b> (luz dorada) esparcidos
    por la zona.\n\u2022 Recoge botiquines para restaurar tu salud si eres impactado.\n\u2022
    Ten cuidado con los <b>obst\xE1culos m\xF3viles y balizas de peligro</b>.\n\u2022
    Ac\xE9rcate al <b>Paciente Herido</b> en el puesto de triage para estabilizarlo
    y completar el rescate.\n\n<b>CONTROLES DEL DOCTOR:</b>\n\u2022 <b>W, A, S, D</b>:
    Moverse en el escenario.\n\u2022 <b>Shift Izquierdo</b>: Correr / Acelerar paso.\n\u2022
    <b>Espacio</b>: Saltar obst\xE1culos.\n\u2022 <b>Rat\xF3n</b>: Mover y orientar
    la c\xE1mara en tercera persona.\n\u2022 <b>ESC</b>: Pausa y acceso instant\xE1neo
    al Men\xFA de Ajustes."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
