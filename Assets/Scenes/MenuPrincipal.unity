  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FFBC0A>TU MISI\xD3N</color></b>\n\nHabla con el m\xE9dico del
    Hub y elige una misi\xF3n.\n\nBusca <b>jeringas</b> y <b>equipajes de salud</b>
    y ll\xE9valos al paciente.\n\nJunta <b>monedas</b> por el mapa y g\xE1stalas
    en la tienda del Hub.\n\nEvita el fuego y a los <b>saqueadores</b>: si te ven,
    te persiguen. Esc\xF3ndete o defi\xE9ndete con un arma de la tienda."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0fb17a32194307c43864c4f68fbf70ca, type: 2}
  m_sharedMaterial: {fileID: 3882467973619189635, guid: 0fb17a32194307c43864c4f68fbf70ca, type: 2}
